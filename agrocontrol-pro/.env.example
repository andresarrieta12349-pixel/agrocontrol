# ============================================================
# AgroControl Pro - ejemplo de configuración
# Copiá este archivo como ".env" y completá tus valores reales.
# NUNCA subas el archivo ".env" al repositorio.
# ============================================================

# --- Entorno ---
# "development" en tu máquina, "production" en el servidor.
ENVIRONMENT=development

# --- Base de datos ---
# Contraseña de PostgreSQL. Usá solo letras y números (sin @ : / # ?).
# Generala con: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=GENERAR_PASSWORD_BD

# --- Sesiones (JWT) ---
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=GENERAR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Quién puede usar la app ---
# false = solo un administrador crea usuarios (recomendado)
ALLOW_REGISTRATION=false
# Correos de Google que pueden entrar por primera vez aunque el registro
# esté cerrado (separados por coma). Podés dejarlo vacío.
ALLOWED_EMAILS=

# --- Red y CORS ---
# Dominios del frontend que pueden usar la API, separados por coma. NO uses "*".
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
# "true" en producción (HTTPS). "false" solo en desarrollo local.
COOKIE_SECURE=false
# "true" solo si hay Nginx u otro proxy delante de la API
TRUST_PROXY_HEADERS=false
# 127.0.0.1 = solo tu máquina. Cambialo solo si sabés lo que hacés.
BIND_ADDRESS=127.0.0.1

# --- Login con Google ---
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_NUEVO
# Debe coincidir EXACTAMENTE con lo cargado en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
