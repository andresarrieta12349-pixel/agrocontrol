# AgroControl Pro - Environment Variables
# Copy this file to .env and update the values

# Application Settings
APP_NAME=AgroControl Pro
APP_VERSION=1.0.0
DEBUG=False

# Database Configuration
# MySQL connection string
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agrocontrol_pro

# JWT Settings
# Change SECRET_KEY to a random string in production (at least 32 characters)
SECRET_KEY=your-secret-key-change-in-production-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Server Settings
HOST=0.0.0.0
PORT=3000

# CORS Settings (comma-separated origins)
# CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:5500
